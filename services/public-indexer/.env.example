# Public Indexer Service Configuration
# Copy to .env and adjust values.

# Server
INDEXER_PORT=8001
INDEXER_HOST=0.0.0.0

# PostgreSQL (main DB)
DB_URL=postgres://tcc_user:tcc_pass@postgres:5432/tcc_db

# MongoDB (public book catalog)
MONGO_URL=mongodb://tcc_mongo_user:tcc_mongo_pass@mongodb:27017

# MinIO
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=tcc_minio_admin
MINIO_SECRET_KEY=tcc_minio_pass
MINIO_USE_SSL=false
MINIO_BUCKET=tcc-public-index

# External Sources (placeholders - replace with real keys)
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
PROJECT_GUTENBERG_BASE_URL=https://www.gutenberg.org

# Indexing
BATCH_SIZE=100
SYNC_INTERVAL_MINUTES=60
MAX_RETRIES=3
