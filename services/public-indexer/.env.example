# Public Indexer Service Configuration
# Copy to .env and adjust values.

# Server
INDEXER_PORT=8001
INDEXER_HOST=0.0.0.0

# PostgreSQL (main DB + pgvector)
DB_URL=postgresql://tcc_user:tcc_pass@postgres:5432/tcc_db

# MongoDB (public book catalog)
MONGO_URL=mongodb://tcc_mongo_user:tcc_mongo_pass@mongodb:27017
MONGO_DB=tcc_catalog

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tcc_minio_admin
MINIO_SECRET_KEY=tcc_minio_pass
MINIO_USE_SSL=false
MINIO_BUCKET=tcc-public-index

# Redis (semantic cache and queue)
REDIS_URL=redis://:tcc_redis_pass@redis:6379/0

# External Sources (placeholders - replace with real keys)
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
PROJECT_GUTENBERG_BASE_URL=https://www.gutenberg.org

# Scientific Sources (OpenAlex, arXiv, Crossref)
# OpenAlex: API aberta de metadados academicos (works, authors, concepts)
OPENALEX_ENABLED=true
OPENALEX_BASE_URL=https://api.openalex.org
# arXiv: API de query Atom/XML para artigos de pre-print
ARXIV_ENABLED=true
ARXIV_BASE_URL=http://export.arxiv.org
# Crossref: API de metadados academicos com DOI
CROSSREF_ENABLED=true
CROSSREF_BASE_URL=https://api.crossref.org

# Indexing
BATCH_SIZE=100
SYNC_INTERVAL_MINUTES=60
MAX_RETRIES=3
