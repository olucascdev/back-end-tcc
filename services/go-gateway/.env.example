# Go Gateway Service Configuration
# Copy to .env and adjust values.

# Server
GO_GATEWAY_PORT=8080
GO_GATEWAY_HOST=0.0.0.0

# Python Agent Service URL (internal docker network)
PYTHON_AGENT_URL=http://python-agent:8000

# Redis
# Dentro do Docker network usa porta 6379 (porta interna do container).
# Fora do Docker (acesso via host) usa porta 6380 (mapeada no docker-compose).
REDIS_URL=redis://:tcc_redis_pass@redis:6379/0

# PostgreSQL
DB_URL=postgres://tcc_user:tcc_pass@postgres:5432/tcc_db

# MinIO
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=tcc_minio_admin
MINIO_SECRET_KEY=tcc_minio_pass
MINIO_USE_SSL=false

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=20

# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30s

# Semantic Cache TTL
CACHE_TTL=300
