# Python Agent Service Configuration
# Copy to .env and adjust values.

# Server
PYTHON_AGENT_PORT=8000
PYTHON_AGENT_HOST=0.0.0.0

# PostgreSQL
DB_URL=postgres://tcc_user:tcc_pass@postgres:5432/tcc_db

# OpenAI (or compatible LLM provider)
# For default OpenAI: leave OPENAI_BASE_URL empty.
# For Groq: set OPENAI_BASE_URL=https://api.groq.com/openai/v1 and use a Groq model.
# For other OpenAI-compatible providers: set the appropriate base_url.
OPENAI_API_KEY=sk-placeholder-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# MinIO
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=tcc_minio_admin
MINIO_SECRET_KEY=tcc_minio_pass
MINIO_USE_SSL=false
MINIO_BUCKET=tcc-documents

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Processing
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_DOCUMENT_SIZE_MB=50
