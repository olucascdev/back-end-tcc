# =============================================================================
# TCC Backend - Global Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env with real secrets.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=tcc_user
POSTGRES_PASSWORD=tcc_pass
POSTGRES_DB=tcc_db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=tcc_redis_pass
REDIS_PORT=6380

# --- Cache Semantico ---
CACHE_TTL=5m
CACHE_ENABLED=true

# --- Rate Limiting ---
# Backend: "memory" (local token bucket) ou "redis" (distribuido via INCR/EXPIRE)
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_BURST=20

# --- MongoDB ---
MONGO_USER=tcc_mongo_user
MONGO_PASSWORD=tcc_mongo_pass
MONGO_PORT=27017

# --- MinIO ---
MINIO_ROOT_USER=tcc_minio_admin
MINIO_ROOT_PASSWORD=tcc_minio_pass
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# --- Service URLs (internal docker network) ---
POSTGRES_URL=postgres://tcc_user:tcc_pass@postgres:5432/tcc_db
REDIS_URL=redis://:tcc_redis_pass@redis:6379/0
MONGO_URL=mongodb://tcc_mongo_user:tcc_mongo_pass@mongodb:27017
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_URL=http://localhost:9001
